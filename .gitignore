# System & OS
.DS_Store

# Ignore all dot-files and dot-directories (except .gitignore)
.*
!.gitignore

# Ignore Agent workflow entry rules
AGENTS.md
AGENTS.kernel.md

# Python bytecode & test caches
__pycache__/
*.pyc
.pytest_cache/
.hypothesis/

# Build outputs and local execution evidence
build/
dist/
*.egg-info/
runtime.db*
credentials/
browser-profile/
*.har
cookie*.json
storage-state*.json
